{
  "name": "reachinbox-scheduler-backend",
  "version": "1.0.0",
  "description": "Email job scheduler API + worker (BullMQ, Postgres, Redis)",
  "scripts": {
    "dev": "concurrently -n api,worker -c blue,magenta \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "concurrently -n api,worker \"npm:start:api\" \"npm:start:worker\"",
    "start:api": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "load:seed": "tsx scripts/seed-load.ts"
  },
  "type": "commonjs",
  "dependencies": {
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@elastic/elasticsearch": "^8.19.2",
    "@prisma/client": "^6.19.3",
    "bullmq": "^6.3.14",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-basic-auth": "^1.2.1",
    "google-auth-library": "^11.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^10.0.6",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
