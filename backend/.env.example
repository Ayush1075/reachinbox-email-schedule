# ─────────────────────────────────────────────────────────────────────────────
# Backend configuration. Copy to `.env` and fill in the REQUIRED values.
# Every variable is validated at boot (src/config/env.ts); the process exits
# with a readable message if anything is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Infrastructure (defaults match docker-compose.yml) ───────────────────────
# REQUIRED
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/email_scheduler?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ── Public URLs ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# ── Auth & secrets ───────────────────────────────────────────────────────────
# REQUIRED. Random string, >= 32 chars:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=168
# REQUIRED. 32 random bytes, base64. Encrypts SMTP passwords + Slack webhook URLs at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# REQUIRED. OAuth 2.0 Web client ID from Google Cloud Console (see README → Google OAuth setup).
GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# ── Slack (optional; integration shows "not configured" if blank) ────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Must exactly match a Redirect URL registered in your Slack app (HTTPS — see README).
SLACK_REDIRECT_URI=

# ── Bull Board (/admin/queues, HTTP basic auth) ──────────────────────────────
BULL_BOARD_USER=admin
# REQUIRED, >= 8 chars
BULL_BOARD_PASSWORD=change-me-please

# ── Queue / worker ───────────────────────────────────────────────────────────
QUEUE_NAME=email-send
# Jobs processed in parallel per worker process
WORKER_CONCURRENCY=5
# Coarse global throttle across ALL workers (BullMQ limiter): max jobs per duration
QUEUE_GLOBAL_RATE_MAX=50
QUEUE_GLOBAL_RATE_DURATION_MS=1000
# SMTP failure retries (exponential backoff starting at JOB_BACKOFF_MS)
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000
# How long finished jobs stay in Redis (Postgres keeps the permanent record)
REMOVE_ON_COMPLETE_AGE_S=86400
REMOVE_ON_FAIL_AGE_S=604800
# Jobs per queue.addBulk() call when enqueuing large campaigns
ENQUEUE_CHUNK_SIZE=500

# ── Rate limiting ────────────────────────────────────────────────────────────
# Global default hourly cap per sender (lowest precedence)
MAX_EMAILS_PER_HOUR=200
# Optional override of the above, specifically per sender
MAX_EMAILS_PER_HOUR_PER_SENDER=
# Minimum gap between two sends from the same sender
MIN_DELAY_BETWEEN_EMAILS_MS=2000

# ── Reconciler (safety net — NOT the scheduler) ──────────────────────────────
RECONCILE_INTERVAL_MS=300000
# A worker claim older than this, with no live BullMQ job, is treated as abandoned
STALE_CLAIM_MS=120000
