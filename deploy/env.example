# Copy to .env.prod on the server and fill in. Never commit the real file.

# Public hostname (no scheme), e.g. onb-scheduler.duckdns.org
DOMAIN=

# Generate:  openssl rand -base64 48        (JWT_SECRET)
#            openssl rand -base64 32        (ENCRYPTION_KEY, must be 32 bytes)
#            openssl rand -hex 24           (passwords)
POSTGRES_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=
BULL_BOARD_PASSWORD=

# Same OAuth client ID the frontend was built with
GOOGLE_CLIENT_ID=

# Optional: Slack alerts. Redirect URL is https://<DOMAIN>/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
