# Copy to .env.local. Both values are public (embedded in the browser bundle).

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# REQUIRED. Same OAuth 2.0 Web client ID as backend GOOGLE_CLIENT_ID.
# Authorized JavaScript origin must include http://localhost:3000 (see README).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
